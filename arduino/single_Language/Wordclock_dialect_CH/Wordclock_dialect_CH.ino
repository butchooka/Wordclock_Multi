// ============================ SETTINGS ============================
// Colour selection per group: 0..7 palette, 8 = random (groups 0-3) or temperature (groups 4-5), 9 = custom colour,
// 10 = pride (group 0 only: one random colour per time word, re-rolled every minute),
// 11 = off (groups 1-5: the additional display is switched off, replaces the former switches)
// Groups: 0 time/minutes, 1 VENT, 2 ALARM, 3 BATTERY, 4 temperature outside, 5 temperature inside
struct Settings {
  String ssid, pass, host;
  bool ntpDhcp;
  String ntp, tz;
  float lat, lon;
  int nso, neo;                 // night start/end offset in minutes to sunset/sunrise
  uint8_t nmode;                // night mode: 0 sun position, 1 fixed times, 2 mixed
  int nfs, nfe;                 // fixed times: night from/until (minutes since midnight)
  int nme, nml;                 // mixed: night not before / not after
  uint8_t brD, brN;             // brightness day/night in %
  uint16_t cur;                 // current limit mA
  uint8_t col[6];
  uint32_t cus[6];              // custom colours 0xRRGGBB
  bool on, swMin, swExtra, tOnl, mir, srp;
  bool uiEn;                    // web interface in English instead of the language of the clock
  float tiMin, tiMax, toMin, toMax;
  uint8_t fxd;                  // effect duration s (0 = until stopped)
  float blk;                    // blink cycle s
  uint16_t apiTo;               // validity of values set via HTTP in min (0 = unlimited)
  String txt;                   // text of the text ticker
} S;

#define COL_OFF 11
static const uint8_t COL_DEF[6] = {8, 3, 2, 1, 8, 8};  // colour when an additional display is switched on via show_*

void setDefaults() {
  S.ssid = ""; S.pass = ""; S.host = WC_LANG.host;
  S.ntpDhcp = true; S.ntp = "pool.ntp.org"; S.tz = WC_LANG.posix_tz;
  S.lat = WC_LANG.lat; S.lon = WC_LANG.lon; S.nso = 0; S.neo = 0;
  S.nmode = 2; S.nfs = 22 * 60; S.nfe = 7 * 60; S.nme = 20 * 60; S.nml = 7 * 60;
  S.brD = 40; S.brN = 1; S.cur = 500;
  // time: random, additional displays (groups 1-5) off by default
  for (int i = 0; i < 6; i++) { S.col[i] = i ? COL_OFF : COL_DEF[0]; S.cus[i] = 0xFF8C28; }
  S.on = true; S.swMin = true; S.swExtra = false;
  S.tOnl = true; S.mir = true; S.srp = true;   // zigzag wiring as default
  S.uiEn = false;
  S.tiMin = 20; S.tiMax = 25; S.toMin = 5; S.toMax = 30;
  S.fxd = 30; S.blk = 1.5f; S.apiTo = 30;
  S.txt = WC_LANG.ap_ssid;
}

// Preferences namespace "wortuhr" (the same for all languages, keeps the settings across firmware updates)
void loadSettings() {
  setDefaults();
  prefs.begin("wortuhr", false);
  S.ssid = prefs.getString("ssid", S.ssid);
  S.pass = prefs.getString("pass", S.pass);
  S.host = prefs.getString("host", S.host);
  S.ntpDhcp = prefs.getBool("ntpD", S.ntpDhcp);
  S.ntp = prefs.getString("ntp", S.ntp);
  S.tz = prefs.getString("tz", S.tz);
  S.lat = prefs.getFloat("lat", S.lat);
  S.lon = prefs.getFloat("lon", S.lon);
  S.nso = prefs.getInt("nso", S.nso);
  S.neo = prefs.getInt("neo", S.neo);
  S.nmode = prefs.getUChar("nmode", S.nmode);
  S.nfs = prefs.getInt("nfs", S.nfs);
  S.nfe = prefs.getInt("nfe", S.nfe);
  S.nme = prefs.getInt("nme", S.nme);
  S.nml = prefs.getInt("nml", S.nml);
  S.brD = prefs.getUChar("brD", S.brD);
  S.brN = prefs.getUChar("brN", S.brN);
  S.cur = prefs.getUShort("cur", S.cur);
  char k[4];
  for (int i = 0; i < 6; i++) {
    snprintf(k, sizeof(k), "c%d", i); S.col[i] = prefs.getUChar(k, S.col[i]);
    snprintf(k, sizeof(k), "x%d", i); S.cus[i] = prefs.getUInt(k, S.cus[i]);
  }
  S.on = prefs.getBool("on", S.on);
  S.swMin = prefs.getBool("swMin", S.swMin);
  {  // migration from the former switches (up to v1.0): switch off = colour "off", then the key is removed
    const char *oldk[4] = {"swLuft", "swAlarm", "swAkku", "swTemp"};
    bool mig = false;
    for (int i = 0; i < 4; i++) {
      if (!prefs.isKey(oldk[i])) continue;
      if (!prefs.getBool(oldk[i], false)) {
        if (i < 3) S.col[i + 1] = COL_OFF;
        else { S.col[4] = COL_OFF; S.col[5] = COL_OFF; }
      }
      prefs.remove(oldk[i]);
      mig = true;
    }
    if (mig)
      for (int i = 1; i < 6; i++) { snprintf(k, sizeof(k), "c%d", i); prefs.putUChar(k, S.col[i]); }
  }
  S.swExtra = prefs.getBool("swEx", S.swExtra);
  S.tOnl = prefs.getBool("tOnl", S.tOnl);
  S.mir = prefs.getBool("mir", S.mir);
  S.srp = prefs.getBool("srp", S.srp);
  S.uiEn = prefs.getBool("uiEn", S.uiEn);
  S.tiMin = prefs.getFloat("tiMin", S.tiMin);
  S.tiMax = prefs.getFloat("tiMax", S.tiMax);
  S.toMin = prefs.getFloat("toMin", S.toMin);
  S.toMax = prefs.getFloat("toMax", S.toMax);
  S.fxd = prefs.getUChar("fxd", S.fxd);
  S.blk = prefs.getFloat("blk", S.blk);
  S.apiTo = prefs.getUShort("apiTo", S.apiTo);
  S.txt = prefs.getString("txt", S.txt);
  prefs.end();
}

