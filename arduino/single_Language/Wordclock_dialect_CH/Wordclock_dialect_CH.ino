// ============================ LED OUTPUT (WS2812, GRB) ============================
#if ESP_ARDUINO_VERSION_MAJOR >= 3
#include "soc/soc_caps.h"
// Board package 3.x: RMT directly, 10 MHz clock (100 ns), buffer in static RAM instead of on the stack
static rmt_data_t ledBuf[NUM_LEDS * 24];
static bool ledOk = false;
static uint8_t ledPix[NUM_LEDS * 3];
void ledBegin() {
  // as much RMT memory as the chip allows (fewer blocks on ESP32-C6/C3/S3), less flicker with Wi-Fi
  // (numbers instead of RMT_MEM_NUM_BLOCKS_4: that name does not exist on chips with only 2 TX channels)
  for (int blocks = (SOC_RMT_TX_CANDIDATES_PER_GROUP > 2) ? 4 : 2; blocks >= 1 && !ledOk; blocks /= 2)
    ledOk = rmtInit(LED_PIN, RMT_TX_MODE, (rmt_reserve_memsize_t)blocks, 10000000);
  if (!ledOk) Serial.println("ERROR: RMT for the LEDs not available");
  memset(ledPix, 0, sizeof(ledPix));
}
void ledSet(int i, uint8_t r, uint8_t g, uint8_t b) {
  ledPix[i * 3] = g; ledPix[i * 3 + 1] = r; ledPix[i * 3 + 2] = b;
}
void ledShow() {
  if (!ledOk || !LED_ENABLE) return;
  int n = 0;
  for (int i = 0; i < NUM_LEDS * 3; i++) {
    const uint8_t v = ledPix[i];
    for (int bit = 7; bit >= 0; bit--) {
      rmt_data_t &d = ledBuf[n++];
      const bool one = (v >> bit) & 1;
      d.level0 = 1; d.duration0 = one ? 8 : 4;   // 0.8 us or 0.4 us high
      d.level1 = 0; d.duration1 = one ? 4 : 8;   // 0.4 us or 0.8 us low
    }
  }
  rmtWrite(LED_PIN, ledBuf, n, 100);  // takes approx. 7.7 ms
}
#else
// Board package 2.x: Adafruit NeoPixel (uses the old RMT driver there, without a large stack buffer)
#include <Adafruit_NeoPixel.h>
Adafruit_NeoPixel strip(NUM_LEDS, LED_PIN, NEO_GRB + NEO_KHZ800);
void ledBegin() { strip.begin(); strip.clear(); }
void ledSet(int i, uint8_t r, uint8_t g, uint8_t b) { strip.setPixelColor(i, r, g, b); }
void ledShow() { if (LED_ENABLE) strip.show(); }
#endif
