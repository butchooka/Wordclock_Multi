void handleSave() {
  bool restart = false, sntpChanged = false, sunChanged = false;
  auto has = [](const char *k) { return server.hasArg(k); };
  auto gi = [](const char *k) { return (long)server.arg(k).toInt(); };
  auto gf = [](const char *k) { return server.arg(k).toFloat(); };
  auto cl = [](long v, long lo, long hi) { return v < lo ? lo : (v > hi ? hi : v); };
  auto cf = [](float v, float lo, float hi) { return v < lo ? lo : (v > hi ? hi : v); };

  if (has("on")) S.on = gi("on");
  if (has("swMin")) S.swMin = gi("swMin");
  if (has("swExtra")) S.swExtra = gi("swExtra");
  if (has("tOnl")) { S.tOnl = gi("tOnl"); lastWeather = 0; weatherDone = false; }
  if (has("mir")) S.mir = gi("mir");
  if (has("srp")) S.srp = gi("srp");
  if (has("uiEn")) S.uiEn = gi("uiEn");
  if (has("brD")) S.brD = cl(gi("brD"), 1, 100);
  if (has("brN")) S.brN = cl(gi("brN"), 0, 100);
  if (has("cur")) S.cur = cl(gi("cur"), 100, 3000);
  if (has("lat")) { S.lat = cf(gf("lat"), -90, 90); sunChanged = true; }
  if (has("lon")) { S.lon = cf(gf("lon"), -180, 180); sunChanged = true; }
  if (has("nso")) { S.nso = cl(gi("nso"), -240, 240); sunChanged = true; }
  if (has("neo")) { S.neo = cl(gi("neo"), -240, 240); sunChanged = true; }
  if (has("nmode")) { S.nmode = cl(gi("nmode"), 0, 2); sunChanged = true; }
  {
    int *tf[4] = {&S.nfs, &S.nfe, &S.nme, &S.nml};
    const char *tk[4] = {"nfs", "nfe", "nme", "nml"};
    for (int i = 0; i < 4; i++)
      if (has(tk[i])) { const int m = parseHM(server.arg(tk[i])); if (m >= 0) { *tf[i] = m; sunChanged = true; } }
  }
  char k[4];
  for (int i = 0; i < 6; i++) {
    snprintf(k, sizeof(k), "c%d", i);
    if (has(k)) { S.col[i] = cl(gi(k), 0, i ? COL_OFF : 10); if (i == 0 && S.col[0] == COL_OFF) S.col[0] = COL_DEF[0]; }
    snprintf(k, sizeof(k), "x%d", i);
    if (has(k)) { String v = server.arg(k); v.replace("#", ""); S.cus[i] = strtoul(v.c_str(), nullptr, 16) & 0xFFFFFF; }
  }
  if (has("tiMin")) S.tiMin = cf(gf("tiMin"), -40, 60);
  if (has("tiMax")) S.tiMax = cf(gf("tiMax"), -40, 60);
  if (has("toMin")) S.toMin = cf(gf("toMin"), -40, 60);
  if (has("toMax")) S.toMax = cf(gf("toMax"), -40, 60);
  if (has("fxd")) S.fxd = cl(gi("fxd"), 0, 120);
  if (has("blk")) S.blk = cf(gf("blk"), 0.3f, 3.0f);
  if (has("apiTo")) S.apiTo = cl(gi("apiTo"), 0, 1440);
  if (has("ntpD")) { const bool v = gi("ntpD"); if (v != S.ntpDhcp) { S.ntpDhcp = v; restart = true; } }
  if (has("ntp")) {
    String v = server.arg("ntp"); v.trim();
    if (!v.length()) v = "pool.ntp.org";
    if (v.length() < sizeof(ntpBuf[0]) && v != S.ntp) { S.ntp = v; sntpChanged = true; }
  }
  if (has("tz")) {
    String v = server.arg("tz"); v.trim();
    if (v.length() && v != S.tz) { S.tz = v; applyTZ(); rndHour = -1; }
  }

  if (sunChanged) { updateNight(); lastWeather = 0; weatherDone = false; }
  if (restart) {
    saveSettings();
    sendJson("{\"ok\":true,\"restart\":true}");
    delay(500);
    ESP.restart();
  }
  // DHCP mode: the fallback server only applies after a restart (it would otherwise overwrite the DHCP server)
  if (sntpChanged && !S.ntpDhcp) setupSNTP();
  markDirty();
  sendJson("{\"ok\":true}");
}

void handleScan() {
  const int n = WiFi.scanNetworks();
  String j = "[";
  for (int i = 0; i < n; i++) {
    if (!WiFi.SSID(i).length()) continue;
    if (j.length() > 1) j += ",";
    j += "{\"s\":\"" + jsonEsc(WiFi.SSID(i)) + "\",\"r\":" + String(WiFi.RSSI(i)) +
         ",\"o\":" + String(WiFi.encryptionType(i) == WIFI_AUTH_OPEN ? 1 : 0) + "}";
  }
  j += "]";
  WiFi.scanDelete();
  sendJson(j);
}

void handleWifiSave() {
  String ssid = server.arg("ssid"); ssid.trim();
  String host = server.arg("host"); host.trim(); host.toLowerCase();
  String clean;
  for (size_t i = 0; i < host.length(); i++) {
    const char c = host[i];
    if (isalnum((unsigned char)c) || c == '-') clean += c;
  }
  if (!clean.length()) clean = WC_LANG.host;
  Serial.printf("Wi-Fi form received: SSID \"%s\"\n", ssid.c_str());
  const String head = String("<!DOCTYPE html><html lang='") + tr("html_lang") +
                      "'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'>";
  if (!ssid.length()) {
    server.send(400, "text/html; charset=utf-8",
                head + "<body style='font-family:sans-serif;padding:24px'><h2>" + tr("srv_no_network") +
                    "</h2><p><a href='/'>" + tr("srv_back") + "</a></p></body>");
    return;
  }
  const String pass = server.arg("pass");
  if (pass.length() || ssid != S.ssid) S.pass = pass;  // empty password with the same Wi-Fi = keep the old one
  S.ssid = ssid;
  S.host = clean;
  saveSettings();
  prefs.begin("wortuhr", true);  // read back for checking
  Serial.printf("Wi-Fi saved: \"%s\" (password %u characters), read: \"%s\"\n", S.ssid.c_str(),
                (unsigned)S.pass.length(), prefs.getString("ssid", "").c_str());
  prefs.end();
  String h = head + "<body style='font-family:sans-serif;padding:24px;line-height:1.5'><h2>" + tr("srv_saved") +
             "</h2><p>" + tr("srv_connecting") + " <b>" + htmlEsc(ssid) + "</b> " + tr("srv_restart") + "</p><p>" +
             tr("srv_reach") + " <b>http://" + clean + ".local</b> " + tr("srv_reach2") + "</p><p>" +
             tr("srv_retry") + "</p></body>";
  server.sendHeader("Connection", "close");
  server.send(200, "text/html; charset=utf-8", h);
  server.client().flush();
  delay(1500);
  ESP.restart();
}

void handleSetTime() {  // take over the browser time (e.g. in hotspot mode without internet)
  const long e = server.arg("e").toInt();
  if (e > 1700000000L) {
    struct timeval tv = {(time_t)e, 0};
    settimeofday(&tv, nullptr);
    rndHour = -1;
    updateNight();
  }
  sendJson("{\"ok\":true}");
}

// ---------------- HTTP control: names are the same in all languages ----------------
static const char *const COL_KEYS[6] = {"col_time", "col_vent", "col_alarm", "col_battery", "col_tempout", "col_tempin"};

bool isNum(const String &v, float &out) {
  if (!v.length()) return false;
  char *end = nullptr;
  out = strtof(v.c_str(), &end);
  return end && *end == '\0';
}

bool parseHex(String v, uint32_t &out) {
  v.trim();
  if (v.startsWith("#")) v.remove(0, 1);
  if (v.length() != 6) return false;
  for (size_t i = 0; i < 6; i++) if (!isxdigit((unsigned char)v[i])) return false;
  out = strtoul(v.c_str(), nullptr, 16);
  return true;
}

// colour name/hex to selection (0-7 palette, 8 random or temperature, 9 custom colour, 10 pride, 11 off)
bool parseColorSel(String v, int g, uint8_t &sel, uint32_t &cus) {
  v.trim(); v.toLowerCase();
  if (g > 0 && v == "off") { sel = COL_OFF; return true; }
  for (int i = 0; i < 8; i++) if (v == WC_PAL_KEYS[i]) { sel = i; return true; }
  if (g == 0 && v == "pride") { sel = 10; return true; }
  if ((g < 4 && v == "random") || (g >= 4 && v == "temp")) { sel = 8; return true; }
  uint32_t c;
  if (parseHex(v, c)) { sel = 9; cus = c; return true; }
  return false;
}

String colorName(int g) {
  const uint8_t sel = S.col[g];
  if (sel < 8) return WC_PAL_KEYS[sel];
  if (sel == 10) return "pride";
  if (sel == COL_OFF) return "off";
  if (sel == 8) return g < 4 ? "random" : "temp";
  return hexCol(S.cus[g]);
}

// compatibility of show_* (former switches): off = colour "off", on = default colour (only if it was off)
void showGroup(int g, bool on) {
  if (!on) S.col[g] = COL_OFF;
  else if (S.col[g] == COL_OFF) S.col[g] = COL_DEF[g];
}

void handleApiSet() {
  const uint32_t ms = millis() | 1;
  String applied, ignored;
  auto add = [](String &list, const String &k) { if (list.length()) list += ','; list += '"'; list += jsonEsc(k); list += '"'; };
  bool persist = false;

  for (int i = 0; i < server.args(); i++) {
    const String k = server.argName(i);
    const String v = server.arg(i);
    float f = 0;
    const bool num = isNum(v, f);
    bool ok = false;

    if (k == "plain" || k == "fx" || k == "fxcolor" || k == "text" || k == "textstart" || k == "textcolor")
      continue;  // raw data, effect and text after the loop
    // measured values (not saved, expire after apiTo)
    else if (k == "tout") { if (num) { vTout = f; tsTout = ms; ok = true; } }
    else if (k == "tin") { if (num) { vTin = f; tsTin = ms; ok = true; } }
    else if (k == "akku") { if (num) { vAkku = constrain(f, 0.0f, 100.0f); tsAkku = ms; ok = true; } }
    else if (k == "luft") { if (num) { vLuft = f != 0; tsLuft = ms; ok = true; } }
    else if (k == "alarm") { if (num) { vAlarm = f != 0; tsAlarm = ms; ok = true; } }
    // permanently saved settings
    else if (k == "on") { if (num) { S.on = f != 0; ok = persist = true; } }
    else if (k == "brday") { if (num) { S.brD = constrain((int)lroundf(f), 1, 100); ok = persist = true; } }
    else if (k == "brnight") { if (num) { S.brN = constrain((int)lroundf(f), 0, 100); ok = persist = true; } }
    else if (k == "show_minutes") { if (num) { S.swMin = f != 0; ok = persist = true; } }
    else if (k == "show_temp") { if (num) { showGroup(4, f != 0); showGroup(5, f != 0); ok = persist = true; } }
    else if (k == "show_vent") { if (num) { showGroup(1, f != 0); ok = persist = true; } }
    else if (k == "show_alarm") { if (num) { showGroup(2, f != 0); ok = persist = true; } }
    else if (k == "show_battery") { if (num) { showGroup(3, f != 0); ok = persist = true; } }
    else if (k == "show_extra") { if (num) { S.swExtra = f != 0; ok = persist = true; } }
    else if (k == "fxdur") { if (num) { S.fxd = constrain((int)lroundf(f), 0, 120); ok = persist = true; } }
    else if (k == "fxcycle") { if (num) { S.blk = constrain(f, 0.3f, 3.0f); ok = persist = true; } }
    else {
      for (int g = 0; g < 6; g++)
        if (k == COL_KEYS[g]) { if (parseColorSel(v, g, S.col[g], S.cus[g])) ok = persist = true; break; }
    }
    add(ok ? applied : ignored, k);
  }

  if (server.hasArg("fx")) {  // effect: runs fxdur seconds, then clock mode
    String v = server.arg("fx"); v.trim(); v.toLowerCase();
    const int m = wc_fx_find(v.c_str());
    const bool col = m > 0 && WC_FX[m - 1].uses_color;
    if (col) {
      fxColSel = 6;  // default blue
      if (server.hasArg("fxcolor")) {
        String c = server.arg("fxcolor"); c.trim(); c.toLowerCase();
        uint32_t hex;
        int idx = -1;
        for (int i = 0; i < 8; i++) if (c == WC_PAL_KEYS[i]) idx = i;
        if (idx >= 0) { fxColSel = idx; add(applied, "fxcolor"); }
        else if (parseHex(c, hex)) { fxColSel = 9; fxCus = hex; add(applied, "fxcolor"); }
        else add(ignored, "fxcolor");
      }
    } else if (server.hasArg("fxcolor")) {
      add(ignored, "fxcolor");
    }
    if (m >= 0) { fxMode = m; fxStart = millis(); txtOn = false; add(applied, "fx"); }
    else add(ignored, "fx");
  } else if (server.hasArg("fxcolor")) {
    add(ignored, "fxcolor");
  }

  // text ticker: text = new text (saved) and start, textstart = 1 start the saved text again
  bool txtGo = false;
  if (server.hasArg("text")) {
    String v = server.arg("text");
    v.trim();
    String cut;  // at most WC_TXT_MAX characters (code points)
    int n = 0;
    for (size_t i = 0; i < v.length(); i++) {
      if (((uint8_t)v[i] & 0xC0) != 0x80 && ++n > WC_TXT_MAX) break;
      cut += v[i];
    }
    if (cut.length()) {
      if (cut != S.txt) { S.txt = cut; persist = true; }
      txtGo = true;
      add(applied, "text");
    } else {
      add(ignored, "text");
    }
  }
  if (server.hasArg("textstart")) {
    if (server.arg("textstart").toInt() != 0) { txtGo = true; add(applied, "textstart"); }
    else { txtOn = false; add(applied, "textstart"); }
  }
  if (txtGo) {
    txtColSel = -1;
    if (server.hasArg("textcolor")) {
      String c = server.arg("textcolor"); c.trim(); c.toLowerCase();
      uint32_t hex;
      int idx = -1;
      for (int i = 0; i < 8; i++) if (c == WC_PAL_KEYS[i]) idx = i;
      if (idx >= 0) { txtColSel = idx; add(applied, "textcolor"); }
      else if (c == "rainbow" || c == "random") { txtColSel = 8; add(applied, "textcolor"); }
      else if (parseHex(c, hex)) { txtColSel = 9; txtCus = hex; add(applied, "textcolor"); }
      else add(ignored, "textcolor");
    }
    startText();
  } else if (server.hasArg("textcolor")) {
    add(ignored, "textcolor");
  }

  if (persist) markDirty();
  sendJson("{\"ok\":true,\"applied\":[" + applied + "],\"ignored\":[" + ignored + "]}");
}

void handleApiGet() {
  String j = "{";
  j += "\"on\":" + String(S.on ? 1 : 0);
  j += ",\"brday\":" + String(S.brD) + ",\"brnight\":" + String(S.brN);
  for (int g = 0; g < 6; g++) { j += ",\""; j += COL_KEYS[g]; j += "\":\"" + colorName(g) + "\""; }
  j += ",\"show_minutes\":" + String(S.swMin ? 1 : 0);
  j += ",\"show_temp\":" + String((S.col[4] != COL_OFF || S.col[5] != COL_OFF) ? 1 : 0);
  j += ",\"show_vent\":" + String(S.col[1] != COL_OFF ? 1 : 0);
  j += ",\"show_alarm\":" + String(S.col[2] != COL_OFF ? 1 : 0);
  j += ",\"show_battery\":" + String(S.col[3] != COL_OFF ? 1 : 0);
  j += ",\"show_extra\":" + String(S.swExtra ? 1 : 0);
  j += ",\"fxdur\":" + String(S.fxd) + ",\"fxcycle\":" + String(S.blk, 1);
  j += ",\"fx\":\"" + String(wc_fx_key(fxMode)) + "\"";
  if (fxMode > 0 && WC_FX[fxMode - 1].uses_color) {
    const String fc = fxColSel < 8 ? String(WC_PAL_KEYS[fxColSel]) : hexCol(fxCus);
    j += ",\"fxcolor\":\"" + fc + "\"";
  }
  j += ",\"text\":\"" + jsonEsc(S.txt) + "\",\"text_running\":" + String(txtOn ? 1 : 0);
  j += ",\"night\":" + String(night ? "true" : "false");
  j += ",\"lang\":\"" + String(WC_LANG.code) + "\"";
  j += "}";
  sendJson(j);
}

void handleRestart() {
  if (dirty) saveSettings();
  sendJson("{\"ok\":true}");
  delay(500);
  ESP.restart();
}

void handleReset() {
  prefs.begin("wortuhr", false);
  prefs.clear();
  prefs.end();
  sendJson("{\"ok\":true}");
  delay(500);
  ESP.restart();
}

void handleNotFound() {
  if (apActive) {  // captive portal: redirect everything to the start page
    server.sendHeader("Location", "http://" + WiFi.softAPIP().toString() + "/", true);
    server.send(302, "text/plain", "");
    return;
  }
  server.send(404, "text/plain; charset=utf-8", tr("srv_not_found"));
}

void setupWeb() {
  server.on("/", handleRoot);
  server.on("/api/info", handleInfo);
  server.on("/api/status", handleStatus);
  server.on("/api/config", handleConfig);
  server.on("/api/save", handleSave);
  server.on("/api/scan", handleScan);
  server.on("/api/wifi", HTTP_POST, handleWifiSave);
  server.on("/api/settime", handleSetTime);
  server.on("/api/set", handleApiSet);
  server.on("/api/get", handleApiGet);
  server.on("/api/restart", HTTP_POST, handleRestart);
  server.on("/api/reset", HTTP_POST, handleReset);
  server.onNotFound(handleNotFound);
  server.begin();
}

// ============================ SETUP / LOOP ============================
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println();
  Serial.println(fwVersion());
  Serial.printf("Reset reason: %d\n", (int)esp_reset_reason());  // 1 = power on, 3 = restart, 4-7 = crash/watchdog, 9 = brownout
  wc_seed(esp_random());
  loadSettings();
  Serial.printf("Saved Wi-Fi: \"%s\" (password %u characters)\n", S.ssid.c_str(), (unsigned)S.pass.length());
  Serial.flush();
  applyTZ();

  ledBegin();
  ledShow();
  Serial.println("LEDs ready"); Serial.flush();

  WiFi.persistent(false);
  WiFi.setHostname(S.host.c_str());
  WiFi.onEvent([](WiFiEvent_t e, WiFiEventInfo_t info) {
    if (e == ARDUINO_EVENT_WIFI_STA_DISCONNECTED) {
      lastReason = info.wifi_sta_disconnected.reason;
      Serial.printf("Wi-Fi disconnected, reason %d (2/15/202/204 = password, 201 = network not found)\n", lastReason);
    } else if (e == ARDUINO_EVENT_WIFI_STA_GOT_IP) {
      lastReason = 0;
      Serial.printf("Wi-Fi connected, IP %s, http://%s.local\n", WiFi.localIP().toString().c_str(), S.host.c_str());
    }
  });
  Serial.println("Wi-Fi starting ..."); Serial.flush();
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);  // without this the ESP32 misses requests in power save mode, the web interface hangs
  if (WIFI_TX_LOW) WiFi.setTxPower(WIFI_POWER_8_5dBm);
  WiFi.setAutoReconnect(true);
  setupSNTP();  // before WiFi.begin, so that the NTP server from the DHCP answer is taken over

  if (S.ssid.length()) {
    Serial.printf("Connecting to \"%s\" ...\n", S.ssid.c_str());
    WiFi.begin(S.ssid.c_str(), S.pass.c_str());
    const uint32_t t0 = millis();
    while (WiFi.status() != WL_CONNECTED && millis() - t0 < 30000) {
      render();  // prefix ("ES IST") while connecting
      delay(50);
    }
  }
  if (WiFi.status() == WL_CONNECTED) {
    Serial.printf("Connected, IP %s\n", WiFi.localIP().toString().c_str());
    staOkSince = millis();
  } else {
    startAP();  // no Wi-Fi saved or not found
    lastWifiTry = millis();
    wifiLostAt = millis();
  }

  setupWeb();
  updateNight();
  xTaskCreatePinnedToCore(weatherTask, "weather", 10240, nullptr, 1, nullptr, 0);
  Serial.println("Web server running"); Serial.flush();
}

void loop() {
  server.handleClient();
  if (apActive) dns.processNextRequest();
  handleWifi();

  const uint32_t ms = millis();
  if (ms - lastNight > 5000) { lastNight = ms; updateNight(); }
  if (dirty && ms - dirtyAt > 3000) { dirty = false; saveSettings(); }  // spare the flash: save collected
  if (ms - lastRender >= 50) { lastRender = ms; render(); }
  delay(1);
}
