bool fresh(uint32_t ts) {
  if (!ts) return false;
  if (!S.apiTo) return true;
  return millis() - ts < (uint32_t)S.apiTo * 60000UL;
}
float curTout() {
  if (fresh(tsTout)) return vTout;  // a value set via HTTP has priority
  if (S.tOnl && tsWeb && millis() - tsWeb < 3600000UL) return vWeb;
  return NAN;
}
float curTin()  { return fresh(tsTin) ? vTin : NAN; }
float curAkku() { return fresh(tsAkku) ? vAkku : NAN; }
bool curLuft()  { return fresh(tsLuft) && vLuft; }
bool curAlarm() { return fresh(tsAlarm) && vAlarm; }

bool timeValid() { return time(nullptr) > 1700000000; }

// ============================ SUN POSITION ============================
// Sunrise/sunset (zenith 90.833 deg = altitude -0.833 deg as in ESPHome) in minutes UTC, NAN = does not happen
float sunUTC(int doy, float lat, float lon, bool rise) {
  const float D2R = 0.01745329252f, R2D = 57.2957795131f;
  const float zenith = 90.833f;
  const float lngHour = lon / 15.0f;
  const float t = doy + ((rise ? 6.0f : 18.0f) - lngHour) / 24.0f;
  const float M = 0.9856f * t - 3.289f;
  float L = M + 1.916f * sinf(M * D2R) + 0.020f * sinf(2.0f * M * D2R) + 282.634f;
  L = fmodf(L + 720.0f, 360.0f);
  float RA = R2D * atanf(0.91764f * tanf(L * D2R));
  RA = fmodf(RA + 720.0f, 360.0f);
  RA += floorf(L / 90.0f) * 90.0f - floorf(RA / 90.0f) * 90.0f;
  RA /= 15.0f;
  const float sinDec = 0.39782f * sinf(L * D2R);
  const float cosDec = cosf(asinf(sinDec));
  const float cosH = (cosf(zenith * D2R) - sinDec * sinf(lat * D2R)) / (cosDec * cosf(lat * D2R));
  if (cosH > 1.0f || cosH < -1.0f) return NAN;
  float H = rise ? 360.0f - R2D * acosf(cosH) : R2D * acosf(cosH);
  H /= 15.0f;
  const float T = H + RA - 0.06571f * t - 6.622f;
  float UT = fmodf(T - lngHour + 48.0f, 24.0f);
  return UT * 60.0f;
}

int wrapDay(int m) { return ((m % 1440) + 1440) % 1440; }

// Night detection (time of day only, local time) and hourly random colours
void updateNight() {
  if (!timeValid()) { night = false; return; }
  time_t now = time(nullptr);
  struct tm lt, gt;
  localtime_r(&now, &lt);
  gmtime_r(&now, &gt);

  if (rndHour != lt.tm_hour) {  // new random colour every full hour, never the same twice in a row
    rndHour = lt.tm_hour;
    for (int g = 0; g < 4; g++) rnd[g] = wc_pick_random(rnd[g]);
  }

  int dd = lt.tm_yday - gt.tm_yday;
  if (dd > 1) dd = -1; else if (dd < -1) dd = 1;  // turn of the year
  const int off = dd * 1440 + (lt.tm_hour * 60 + lt.tm_min) - (gt.tm_hour * 60 + gt.tm_min);
  const float r = sunUTC(lt.tm_yday + 1, S.lat, S.lon, true);
  const float s = sunUTC(lt.tm_yday + 1, S.lat, S.lon, false);
  const bool sunOk = !isnan(r) && !isnan(s);
  if (sunOk) {
    srMin = wrapDay((int)lroundf(r) + off);
    ssMin = wrapDay((int)lroundf(s) + off);
  } else {
    srMin = ssMin = -1;
  }
  int startm, endm;
  if (S.nmode == 1 || !sunOk) {  // fixed times (also as fallback if no sun times can be calculated)
    startm = S.nfs;
    endm = S.nfe;
  } else {
    startm = wrapDay(ssMin + S.nso);
    endm = wrapDay(srMin + S.neo);
    if (S.nmode == 2) {  // mixed: start = later, end = earlier point in time
      auto rel = [](int m) { return (wrapDay(m) - 720 + 1440) % 1440; };  // minutes from 12:00 (across midnight)
      if (rel(S.nme) > rel(startm)) startm = S.nme;
      if (rel(S.nml) < rel(endm)) endm = S.nml;
    }
  }
  startm = wrapDay(startm);
  endm = wrapDay(endm);
  nightStart = startm;
  nightEnd = endm;
  const int nowm = lt.tm_hour * 60 + lt.tm_min;
  night = (startm > endm) ? (nowm >= startm || nowm < endm) : (nowm >= startm && nowm < endm);
}

// ============================ DISPLAY ============================
static WcRgb frame[WC_N];

WcRgb groupColor(int g) {  // groups 0-3
  const uint8_t sel = S.col[g];
  if (sel == 9) return wc_hex(S.cus[g]);
  return wc_pal_or_random(sel, rnd[g]);
}

void renderClock() {
  WcClockIn in;
  memset(&in, 0, sizeof(in));
  in.valid = timeValid();
  int32_t mod = -1;
  if (in.valid) {
    time_t now = time(nullptr);
    struct tm t;
    localtime_r(&now, &t);
    in.hour = t.tm_hour;
    in.minute = t.tm_min;
    mod = t.tm_hour * 60 + t.tm_min;
  }
  in.show_minutes = S.swMin; in.show_extra = S.swExtra;
  in.show_vent = S.col[1] != COL_OFF; in.show_alarm = S.col[2] != COL_OFF; in.show_battery = S.col[3] != COL_OFF;
  in.show_tout = S.col[4] != COL_OFF; in.show_tin = S.col[5] != COL_OFF;
  in.vent = curLuft(); in.alarm = curAlarm(); in.battery = curAkku();
  in.t_out = curTout(); in.t_in = curTin();
  in.t_out_lo = S.toMin; in.t_out_hi = S.toMax; in.t_in_lo = S.tiMin; in.t_in_hi = S.tiMax;
  // no time: the extra words (easter egg) are shown instead of the prefix (wc_render_clock);
  // hotspot active (no Wi-Fi saved or Wi-Fi not reachable): they pulse blue, otherwise static in the time colour
  if (!in.valid && apActive) {
    const float v = 0.15f + 0.85f * (0.5f - 0.5f * cosf(millis() / 1000.0f * 3.1415926f));
    in.c_time = wc_rgb(0, 0, (uint8_t)(255 * v));
  } else {
    in.c_time = groupColor(0);
  }
  if (S.col[0] == 10 && in.valid) {  // pride: one random colour per time word, re-rolled each minute
    in.pride = true;
    in.pride_col = wc_pride_refresh(mod);
  }
  in.c_vent = groupColor(1);
  in.c_alarm = groupColor(2);
  in.c_battery = groupColor(3);
  in.tout_scale = S.col[4] == 8;
  in.tin_scale = S.col[5] == 8;
  in.c_tout = S.col[4] == 9 ? wc_hex(S.cus[4]) : WC_PAL[S.col[4] < 8 ? S.col[4] : 0];
  in.c_tin = S.col[5] == 9 ? wc_hex(S.cus[5]) : WC_PAL[S.col[5] < 8 ? S.col[5] : 0];
  wc_render_clock(WC_LANG, in, frame);
}

WcRgb fxColor() { return fxColSel == 9 ? wc_hex(fxCus) : WC_PAL[fxColSel < 8 ? fxColSel : 6]; }

// starts the text ticker with the saved text S.txt (stops a running effect)
void startText() {
  wc_text_set(txt, S.txt.c_str());
  if (!txt.n) { txtOn = false; return; }
  fxMode = 0;
  txtOn = true;
  txtStart = millis();
}

void render() {
  const uint32_t ms = millis();
  if (fxMode && S.fxd && ms - fxStart > (uint32_t)S.fxd * 1000UL) fxMode = 0;
  if (txtOn && !wc_text_running(txt, (ms - txtStart) / 1000.0f)) txtOn = false;
  if (txtOn) {
    // colour: as set for this run, otherwise the colour of the time ("random" = rainbow letter by letter)
    const int sel = txtColSel >= 0 ? txtColSel : (S.col[0] == 8 ? 8 : -1);
    const WcRgb c = sel == 9 ? wc_hex(txtCus) : (sel >= 0 && sel < 8) ? WC_PAL[sel] : groupColor(0);
    wc_text_render(txt, (ms - txtStart) / 1000.0f, c, sel == 8, frame);
  } else if (fxMode) {
    WcFxCtx c;
    c.ms = ms;
    c.t = ms / 1000.0f;
    c.ts = (ms - fxStart) / 1000.0f;
    c.cycle = S.blk;
    c.color = fxColor();
    wc_fx_render(fxMode, frame, c);
  } else if (S.on) {
    renderClock();
  } else {
    memset(frame, 0, sizeof(frame));
  }

  float bf = (night ? S.brN : S.brD) / 100.0f;
  if ((fxMode || txtOn) && bf < 0.10f) bf = 0.10f;  // effects and text always visible with at least 10 %
  wc_output(frame, bf, S.cur, MA_PER_CHANNEL, IDLE_MA_PER_LED, S.mir, S.srp, ledSet);
  ledShow();
}

