// DHCP mode: server from DHCP (option 42), otherwise S.ntp as fallback. Manual: only S.ntp.
void setupSNTP() {
  TCPIP_LOCK();
#if HAVE_DHCP_NTP
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  esp_sntp_servermode_dhcp(S.ntpDhcp);
#else
  sntp_servermode_dhcp(S.ntpDhcp ? 1 : 0);
#endif
#endif
  TCPIP_UNLOCK();
  ntpIdx ^= 1;  // lwIP only keeps the pointer to the name, therefore an own, permanent buffer
  strlcpy(ntpBuf[ntpIdx], S.ntp.c_str(), sizeof(ntpBuf[0]));
  configTzTime(S.tz.c_str(), ntpBuf[ntpIdx]);
}

String ntpInfo() {
  const char *name = nullptr;
  const ip_addr_t *addr = nullptr;
  TCPIP_LOCK();
#if ESP_ARDUINO_VERSION_MAJOR >= 3
  name = esp_sntp_getservername(0);
  addr = esp_sntp_getserver(0);
#else
  name = sntp_getservername(0);
  addr = sntp_getserver(0);
#endif
  String s;
  if (name && *name) s = name;
  else if (addr && !ip_addr_isany(addr)) { s = ipaddr_ntoa(addr); s += " (DHCP)"; }
