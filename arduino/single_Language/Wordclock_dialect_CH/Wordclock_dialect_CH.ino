}

// ============================ OPEN-METEO ============================
void fetchWeather() {
  if (!S.tOnl || WiFi.status() != WL_CONNECTED) return;
  // plain HTTP (Open-Meteo answers without TLS): no TLS library and no HTTPClient, saves a lot of flash
  WiFiClient client;
  client.setTimeout(5);  // seconds
  if (!client.connect("api.open-meteo.com", 80, 4000)) { Serial.println("Open-Meteo: no connection"); return; }
  char req[200];
  snprintf(req, sizeof(req),
           "GET /v1/forecast?latitude=%.4f&longitude=%.4f&current=temperature_2m HTTP/1.0\r\n"
           "Host: api.open-meteo.com\r\nConnection: close\r\n\r\n", S.lat, S.lon);
  client.print(req);
  String resp;
  resp.reserve(1200);
  const uint32_t t0 = millis();
  while ((client.connected() || client.available()) && millis() - t0 < 6000 && resp.length() < 3000) {
    while (client.available()) resp += (char)client.read();
    delay(5);
  }
  client.stop();
  const int sp = resp.indexOf(' ');
  const int code = sp > 0 ? resp.substring(sp + 1, sp + 4).toInt() : 0;
  Serial.printf("Open-Meteo: HTTP %d\n", code);
  if (code != 200) return;
  const int p = resp.indexOf("\"current\":{");
  const int q = (p >= 0) ? resp.indexOf("\"temperature_2m\":", p) : -1;
  if (q >= 0) {
    vWeb = resp.substring(q + 17).toFloat();
    tsWeb = millis() | 1;
    Serial.printf("Open-Meteo: %.1f degC\n", vWeb);
  }
}

// Own task on core 0: the TLS connection can take a few seconds, web interface and display keep running
void weatherTask(void *) {
  for (;;) {
    const uint32_t ms = millis();
    if (S.tOnl && WiFi.status() == WL_CONNECTED && !apActive && staOkSince && ms - staOkSince > 20000 &&
        (!weatherDone || ms - lastWeather > 15UL * 60UL * 1000UL)) {  // 20 s after connecting, then every 15 min
      weatherDone = true;
      lastWeather = ms;
      fetchWeather();
    }
    vTaskDelay(pdMS_TO_TICKS(1000));
  }
}

// ============================ WI-FI ============================
void startAP() {
  if (apActive) return;
  WiFi.mode(S.ssid.length() ? WIFI_AP_STA : WIFI_AP);
  WiFi.softAP(apSsid(), strlen(AP_PASS) >= 8 ? AP_PASS : nullptr);
  WiFi.setSleep(false);
  if (WIFI_TX_LOW) WiFi.setTxPower(WIFI_POWER_8_5dBm);
  delay(100);
  dns.start(53, "*", WiFi.softAPIP());
  apActive = true;
  Serial.printf("Hotspot \"%s\" active: http://%s\n", apSsid(), WiFi.softAPIP().toString().c_str());
}

void stopAP() {
  if (!apActive) return;
  dns.stop();
  WiFi.softAPdisconnect(true);
  WiFi.mode(WIFI_STA);
  WiFi.setSleep(false);
  if (WIFI_TX_LOW) WiFi.setTxPower(WIFI_POWER_8_5dBm);
  apActive = false;
  Serial.println("Hotspot off");
}

void handleWifi() {
  const uint32_t ms = millis();
  if (!S.ssid.length()) return;  // no Wi-Fi saved: hotspot stays on
  if (WiFi.status() == WL_CONNECTED) {
    wifiLostAt = 0;
    if (!staOkSince) staOkSince = ms;
    if (!mdnsOn && MDNS.begin(S.host.c_str())) { MDNS.addService("http", "tcp", 80); mdnsOn = true; }
    // connected: switch the hotspot off as soon as nobody is connected to it any more
    if (apActive && ms - staOkSince > 10000 && WiFi.softAPgetStationNum() == 0) stopAP();
    return;
  }
  staOkSince = 0;
  if (!wifiLostAt) wifiLostAt = ms;
  if (!apActive && ms - wifiLostAt > 60000) startAP();  // gone for more than 1 min: offer the hotspot
  // in hotspot mode retry regularly (only if nobody is connected to the hotspot right now)
  if (apActive && ms - lastWifiTry > 30000 && WiFi.softAPgetStationNum() == 0) {
    lastWifiTry = ms;
    Serial.printf("Wi-Fi: new attempt with \"%s\"\n", S.ssid.c_str());
    WiFi.begin(S.ssid.c_str(), S.pass.c_str());
  }
}

// ============================ WEB: HELPERS ============================
String jsonEsc(const String &s) {
  String o;
  o.reserve(s.length() + 4);
  for (size_t i = 0; i < s.length(); i++) {
    const char c = s[i];
    if (c == '"' || c == '\\') { o += '\\'; o += c; }
    else if ((uint8_t)c < 0x20) { char b[8]; snprintf(b, sizeof(b), "\\u%04x", c); o += b; }
    else o += c;
  }
  return o;
}

String htmlEsc(const String &s) {
  String o;
  for (size_t i = 0; i < s.length(); i++) {
    const char c = s[i];
    if (c == '<') o += "&lt;"; else if (c == '>') o += "&gt;"; else if (c == '&') o += "&amp;"; else o += c;
  }
  return o;
}

String hm(int m) {
  if (m < 0) return "-";
  char b[6];
  snprintf(b, sizeof(b), "%02d:%02d", m / 60, m % 60);
  return b;
}

int parseHM(const String &v) {  // "HH:MM" -> minutes since midnight, -1 on error
  const int c = v.indexOf(':');
  if (c < 1) return -1;
  const int h = v.substring(0, c).toInt(), m = v.substring(c + 1).toInt();
  if (h < 0 || h > 23 || m < 0 || m > 59) return -1;
  return h * 60 + m;
}

String hexCol(uint32_t c) {
  char b[8];
  snprintf(b, sizeof(b), "#%06lx", (unsigned long)(c & 0xFFFFFF));
  return b;
}

String fnum(float v, int d = 1) { return isnan(v) ? String("null") : String(v, d); }

void sendJson(const String &s) {
  server.sendHeader("Cache-Control", "no-store");
  server.send(200, "application/json", s);
}

void markDirty() { dirty = true; dirtyAt = millis(); }

